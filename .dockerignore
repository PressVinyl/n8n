# Exclusion-only patterns for Railpack / Railway and local Docker builds.
# Upstream’s whitelist-style .dockerignore (ignore * then !paths) makes Railpack emit
# overlapping COPY layers and can fail with: cannot copy to non-directory .../app/**

node_modules
**/node_modules
.git
.github
.turbo
**/.turbo
.pnpm-store
**/.pnpm-store

# Do not exclude `compiled` or `dist` — official Docker builds COPY them from context after CI runs build:n8n.

coverage
.nyc_output
playwright-report
test-results
*.log
pnpm-debug.log

.DS_Store
.idea
.vscode
